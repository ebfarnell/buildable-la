{
  "name": "backyard-scout",
  "version": "1.0.0",
  "description": "Property development analysis system for California ADU and lot splitting opportunities",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/agent_task.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/agent_task.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"*.{json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"*.{json,md}\" \".github/**/*.yml\"",
    "test": "echo \"No tests configured yet\"",
    "precommit": "lint-staged",
    "prepare": "husky || true",
    "run:zip": "tsx src/run_zip.ts",
    "export:csv": "tsx src/csv_export.ts",
    "monitor": "tsx src/monitor.ts",
    "export": "tsx src/csv_export.ts out/results.csv",
    "report": "tsx src/report_html.ts out/report.html",
    "agent": "tsx agent_backyard_scout.ts",
    "agent:help": "tsx agent_backyard_scout.ts --help",
    "area:resolve": "tsx src/cli/resolve_area.ts",
    "extract:online": "tsx src/extract_parcels.ts",
    "monitor:live": "tsx src/monitor.ts",
    "run:task": "tsx src/cli/run_task.ts"
  },
  "keywords": [],
  "author": "Eric Farnell",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "@types/protobufjs": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "commander": "^12.1.0",
    "csv": "^6.4.1",
    "csv-stringify": "^6.6.0",
    "node-fetch": "^3.3.2",
    "proj4": "^2.19.10",
    "protobufjs": "^7.5.4",
    "slugify": "^1.6.6",
    "undici": "^7.16.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
